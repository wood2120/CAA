# Configuración específica para Render.com

# Variables de entorno para producción en Render
DB_HOST=${DATABASE_URL_HOST}
DB_PORT=${DATABASE_URL_PORT}
DB_NAME=${DATABASE_URL_NAME}
DB_USER=${DATABASE_URL_USER}
DB_PASS=${DATABASE_URL_PASSWORD}

# URL del sitio (será proporcionada por Render)
SITE_URL=${RENDER_EXTERNAL_URL}
SITE_NAME=Sistema de Gestión Empresarial

# Configuración de sesiones
SESSION_TIMEOUT=3600

# Zona horaria
TIMEZONE=America/Costa_Rica

# Configuración para producción
DEBUG_MODE=false

# Configuración de seguridad para HTTPS
SESSION_SECURE=true
SESSION_HTTPONLY=true
